# Jarvis Configuration
# Copy this to .env and fill in your values

# OpenAI-compatible API (for various models)
JARVIS_API_BASE_URL=https://api.example.com/v1
JARVIS_API_KEY=sk-your-api-key

# Lark/Feishu (optional)
LARK_APP_ID=
LARK_APP_SECRET=

# Web server port for mobile access
JARVIS_WEB_PORT=3927

# Claude Code path (if not in PATH)
CLAUDE_CODE_PATH=claude
